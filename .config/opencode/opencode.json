{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "share": "manual",
  "logLevel": "INFO",
  "small_model": "openai/gpt-5.6-luna-fast",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "server": {
    "port": 8896,
    "hostname": "127.0.0.1",
    "mdns": false
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama MAC AIR M2",
      "options": {
        "baseURL": "http://192.168.8.235:11434/v1"
      },
      "models": {
        "gemma3n:e4b": {
          "name": "gemma3n"
        },
        "lfm2.5-thinking:latest": {
          "name": "lfm2.5-thinking"
        },
        "codegemma:7b": {
          "name": "codegemma-7b"
        },
        "codegemma:2b": {
          "name": "codegemma-2b"
        },
        "hf.co/unsloth/Phi-4-mini-instruct-GGUF:latest": {
          "name": "phi-4-mini-instruct"
        },
        "qwen2.5-coder:7b-instruct": {
          "name": "qwen2.5-coder-7b-instruct"
        }
      }
    },
    "openai": {},
    "openrouter": {}
  },
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "*brew install*": "deny",
      "*brew uninstall*": "deny",
      "*brew remove*": "deny",
      "*brew cask install*": "deny",
      "*brew cask uninstall*": "deny",
      "*port install*": "deny",
      "*port uninstall*": "deny",
      "*mas install*": "deny",
      "*mas uninstall*": "deny",
      "*installer *": "deny",
      "*softwareupdate --install*": "deny",
      "*pkgutil --forget*": "deny",
      "*rulesync generate*": "deny",
      "*rulesync*generate*": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "deny",
      "opencode.json.bak": "deny",
      ".git/**": "deny",
      ".gitconfig": "deny",
      ".gitmessage": "deny",
      ".githooks/**": "deny",
      ".gitignore": "ask",
      ".gitattributes": "ask",
      ".gitmodules": "ask",
      ".opencode/**": "deny",
      "~/.config/opencode/**": "deny"
    },
    "read": {
      "*.local.json": "deny",
      ".env": "deny",
      "credentials/": "deny"
    }
  },
  "plugin": [
    "oh-my-openagent@4.19.4",
    "@slkiser/opencode-quota@4.9.0",
    "@ramtinj95/opencode-tokenscope@1.8.1",
    "opencode-skill-creator@0.2.25",
    "opencode-rules@0.6.4"
  ],
  "mcp": {
  }
}

{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "opencode",
    "claudecode",
    "codexcli"
  ],
  "features": [
    "rules",
    "mcp",
    "commands",
    "subagents",
    "skills",
    "hooks",
    "permissions"
  ],
  "outputRoots": [
    "."
  ],
  "delete": true,
  "verbose": false,
  "silent": false,
  "global": true,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "gitignoreTargetsOnly": true,
  "sources": [
    // git transport: GitHub API transport hits the rate limit on ~48 files
    {
      "source": "https://github.com/nicobailon/visual-explainer",
      "transport": "git",
      "path": "plugins",
      "skills": ["visual-explainer"]
    }
  ]
}
{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  "permission": {
    "bash": {
      "*": "allow",
      "*brew install*": "deny",
      "*brew uninstall*": "deny",
      "*brew remove*": "deny",
      "*brew cask install*": "deny",
      "*brew cask uninstall*": "deny",
      "*port install*": "deny",
      "*port uninstall*": "deny",
      "*mas install*": "deny",
      "*mas uninstall*": "deny",
      "*installer *": "deny",
      "*softwareupdate --install*": "deny",
      "*pkgutil --forget*": "deny",
      "*rulesync generate*": "deny",
      "*rulesync*generate*": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "deny",
      "opencode.json.bak": "deny",
      ".git/**": "deny",
      ".gitconfig": "deny",
      ".gitmessage": "deny",
      ".githooks/**": "deny",
      ".gitignore": "ask",
      ".gitattributes": "ask",
      ".gitmodules": "ask",
      ".opencode/**": "deny",
      "~/.config/opencode/**": "deny"
    },
    "read": {
      "*.local.json": "deny",
      ".env": "deny",
      "credentials/": "deny"
    }
  },
  "opencode": {
    "permission": {
      "*": "allow",
      "external_directory": "ask",
      "doom_loop": "ask"
    }
  },
  "codexcli": {
    "permission": {
      "edit": {
        "./**": "allow",
        "**/opencode.json": "deny",
        "**/opencode.json.bak": "deny",
        "**/.gitconfig": "deny",
        "**/.gitmessage": "deny",
        ".githooks/**": "deny",
        ".opencode/**": "deny",
        "~/.config/opencode/**": "deny"
      },
      "read": {
        "*.local.json": "deny",
        "**/.env": "deny",
        "credentials/**": "deny"
      }
    }
  },
  "claudecode": {
    "permission": {
      "read": {
        "*": "allow",
        "*.local.json": "deny",
        ".env": "deny",
        "credentials/": "deny"
      },
      "write": {
        "*": "allow"
      },
      "webfetch": {
        "*": "allow"
      },
      "websearch": {
        "*": "allow"
      },
      "grep": {
        "*": "allow"
      },
      "glob": {
        "*": "allow"
      },
      "notebookedit": {
        "*": "allow"
      },
      "agent": {
        "*": "allow"
      }
    },
    "permissions": {
      "defaultMode": "auto"
    }
  }
}
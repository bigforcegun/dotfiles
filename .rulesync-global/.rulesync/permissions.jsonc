{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/permissions-schema.json",
  "permission": {
    "*": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask"
    },
    "doom_loop": {
      "*": "ask"
    },
    "bash": {
      "*": "allow",
      "*brew install*": "deny",
      "*brew uninstall*": "deny",
      "*brew remove*": "deny",
      "*brew cask install*": "deny",
      "*brew cask uninstall*": "deny",
      "*port install*": "deny",
      "*port uninstall*": "deny",
      "*mas install*": "deny",
      "*mas uninstall*": "deny",
      "*installer *": "deny",
      "*softwareupdate --install*": "deny",
      "*pkgutil --forget*": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "deny",
      "opencode.json.bak": "deny",
      ".git/**": "deny",
      ".gitconfig": "deny",
      ".gitmessage": "deny",
      ".githooks/**": "deny",
      ".gitignore": "ask",
      ".gitattributes": "ask",
      ".gitmodules": "ask",
      ".opencode/**": "deny",
      "~/.config/opencode/**": "deny"
    },
    "read": {
      "*.local.json": "deny",
      ".env": "deny",
      "credentials/": "deny"
    }
  }
}
#!/usr/bin/env bash
set -euo pipefail

DIFF=0
ALL_DEPS=0
PACKAGE_JSON="${OPENCODE_UPDATE_PACKAGE_JSON:-./package.json}"
RELEASE_LIMIT="${OPENCODE_UPDATE_RELEASE_LIMIT:-5}"
RELEASE_NOTES_LIMIT="${OPENCODE_UPDATE_RELEASE_NOTES_LIMIT:-3}"

usage() {
  cat >&2 <<'EOF'
usage: collect-opencode-update-info [--all-deps] [--diff] [--package-json path] [package...]

Collect evidence for OpenCode update analysis: local package.json spec,
resolved baseline, npm latest, recent publish history, repository links,
GitHub release notes when gh is available, and compare/diff hints.

Defaults:
  - reads ./package.json from the current directory
  - with no package args, checks OpenCode-related deps only:
    opencode, @opencode-ai/*, opencode-*, *opencode*

Examples:
  collect-opencode-update-info
  collect-opencode-update-info --all-deps
  collect-opencode-update-info --package-json ~/.config/opencode/package.json --diff

Environment:
  OPENCODE_UPDATE_PACKAGE_JSON=path
  OPENCODE_UPDATE_RELEASE_LIMIT=5
  OPENCODE_UPDATE_RELEASE_NOTES_LIMIT=3
EOF
}

die() {
  printf 'collect-opencode-update-info: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

json_get() {
  jq -r "$1 // empty" 2>/dev/null
}

repo_slug() {
  local raw="$1"
  raw="${raw%%#*}"
  raw="${raw#git+}"
  raw="${raw%.git}"
  raw="${raw#https://github.com/}"
  raw="${raw#http://github.com/}"
  raw="${raw#git://github.com/}"
  raw="${raw#ssh://git@github.com/}"
  raw="${raw#git@github.com:}"

  if [[ "$raw" == */* && "$raw" != http* && "$raw" != git:* ]]; then
    printf '%s\n' "${raw%%/*}/${raw#*/}"
  fi
}

package_json_path() {
  local path="$PACKAGE_JSON"
  case "$path" in
    /*) ;;
    *) path="$PWD/${path#./}" ;;
  esac
  printf '%s' "$path"
}

package_json_label() {
  local path
  path="$(package_json_path)"
  if [[ -f "$PACKAGE_JSON" ]]; then
    printf '%s' "$path"
  else
    printf '%s missing' "$path"
  fi
}

local_spec() {
  local pkg="$1"
  [[ -f "$PACKAGE_JSON" ]] || return 0
  jq -r --arg pkg "$pkg" '
    .dependencies[$pkg]
    // .devDependencies[$pkg]
    // .peerDependencies[$pkg]
    // .optionalDependencies[$pkg]
    // empty
  ' "$PACKAGE_JSON" 2>/dev/null || true
}

baseline_version() {
  local pkg="$1" spec="$2"
  if [[ -z "$spec" || "$spec" == latest ]]; then
    return 0
  fi
  if [[ "$spec" =~ ^[0-9]+([.][0-9]+){1,2}([-+][0-9A-Za-z.-]+)?$ ]]; then
    printf '%s\n' "$spec"
    return 0
  fi
  npm view "${pkg}@${spec}" version --json 2>/dev/null | jq -r 'if type == "array" then .[-1] else . end // empty' || true
}

is_opencode_package() {
  local pkg="$1"
  [[ "$pkg" == opencode || "$pkg" == opencode-* || "$pkg" == *opencode* || "$pkg" == @opencode-ai/* ]]
}

package_names_from_json() {
  local filter="$1"
  jq -r '
    [
      (.dependencies // {}),
      (.devDependencies // {}),
      (.peerDependencies // {}),
      (.optionalDependencies // {})
    ]
    | add
    | keys[]?
  ' "$PACKAGE_JSON" | sort -u | while IFS= read -r pkg; do
    if [[ "$filter" == all ]] || is_opencode_package "$pkg"; then
      printf '%s\n' "$pkg"
    fi
  done
}

print_publish_history() {
  local meta="$1"
  printf 'recent npm publishes:\n'
  printf '%s' "$meta" | jq -r '
    .time // {}
    | to_entries
    | map(select(.key != "created" and .key != "modified"))
    | sort_by(.value)
    | reverse
    | .[:5][]?
    | "  - \(.key)  \(.value)"
  '
}

print_release_notes() {
  local slug="$1" tag tags=() count=0 note

  if ! command -v gh >/dev/null 2>&1; then
    printf 'release notes: gh unavailable\n'
    return 0
  fi

  while IFS=$'\t' read -r tag _; do
    [[ -n "$tag" ]] && tags+=("$tag")
  done < <(gh release list -R "$slug" --limit "$RELEASE_LIMIT" 2>/dev/null || true)

  if ((${#tags[@]} == 0)); then
    printf 'release notes: unavailable via gh\n'
    return 0
  fi

  printf 'release notes:\n'
  for tag in "${tags[@]}"; do
    ((count += 1))
    if (( count > RELEASE_NOTES_LIMIT )); then
      break
    fi
    printf '  ## %s\n' "$tag"
    note="$(gh release view "$tag" -R "$slug" --json name,publishedAt,url,body --jq '
      "  title: \(.name // "")\n  date:  \(.publishedAt // "")\n  url:   \(.url // "")\n" +
      ((.body // "") | split("\n") | map(select(length > 0)) | .[:12] | map("    " + .) | join("\n"))
    ' 2>/dev/null || true)"
    if [[ -n "$note" ]]; then
      printf '%s\n' "$note"
    else
      printf '    no release body available\n'
    fi
  done
}

show_package() {
  local pkg="$1" meta latest spec base repo homepage bugs slug

  printf '\n## %s\n' "$pkg"
  if ! meta="$(npm view "$pkg" name version repository.url homepage bugs.url time --json 2>&1)"; then
    printf 'npm: failed to fetch metadata\n%s\n' "$meta" >&2
    return 1
  fi

  latest="$(printf '%s' "$meta" | json_get '.version')"
  spec="$(local_spec "$pkg")"
  base="$(baseline_version "$pkg" "$spec")"
  repo="$(printf '%s' "$meta" | json_get '.repository.url')"
  homepage="$(printf '%s' "$meta" | json_get '.homepage')"
  bugs="$(printf '%s' "$meta" | json_get '.bugs.url')"

  printf 'package.json: %s\n' "$(package_json_label)"
  printf 'local spec:   %s\n' "${spec:-not found}"
  printf 'baseline:     %s\n' "${base:-unknown}"
  printf 'latest:       %s\n' "${latest:-unknown}"
  print_publish_history "$meta"

  [[ -n "$repo" ]] && printf 'repo:         %s\n' "$repo"
  [[ -n "$homepage" ]] && printf 'homepage:     %s\n' "$homepage"
  [[ -n "$bugs" ]] && printf 'bugs:         %s\n' "$bugs"

  slug="$(repo_slug "$repo")"
  [[ -n "$slug" ]] || slug="$(repo_slug "$homepage")"
  if [[ -n "$slug" ]]; then
    print_release_notes "$slug"
    printf 'inspect next:\n'
    printf '  - releases: https://github.com/%s/releases\n' "$slug"
    printf '  - commits:  https://github.com/%s/commits\n' "$slug"
    printf '  - compare:  https://github.com/%s/compare/v%s...v%s\n' "$slug" "${base:-OLD}" "${latest:-NEW}"
  else
    printf 'inspect next:\n'
    printf '  - npm:      https://www.npmjs.com/package/%s\n' "$pkg"
  fi

  printf 'npm diff command: npm diff --diff=%s@%s --diff=%s@%s\n' "$pkg" "${base:-OLD}" "$pkg" "${latest:-NEW}"
  if (( DIFF )) && [[ -n "$base" && -n "$latest" && "$base" != "$latest" ]]; then
    npm diff --diff="${pkg}@${base}" --diff="${pkg}@${latest}" || true
  fi
}

packages=()
while (($#)); do
  case "$1" in
    --all-deps)
      ALL_DEPS=1
      shift
      ;;
    --diff)
      DIFF=1
      shift
      ;;
    --package-json)
      [[ $# -ge 2 ]] || die '--package-json requires a path'
      PACKAGE_JSON="$2"
      shift 2
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -* )
      die "unknown option: $1"
      ;;
    *)
      packages+=("$1")
      shift
      ;;
  esac
done

while (($#)); do
  packages+=("$1")
  shift
done

need npm
need jq

if ((${#packages[@]} == 0)); then
  [[ -f "$PACKAGE_JSON" ]] || die "no packages passed and $(package_json_path) missing; cd into an OpenCode config/project directory or pass --package-json"
  filter=opencode
  (( ALL_DEPS )) && filter=all
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] && packages+=("$pkg")
  done < <(package_names_from_json "$filter")
fi

if ((${#packages[@]} == 0)); then
  die "no OpenCode-related packages found; pass package names explicitly or use --all-deps"
fi

status=0
printf '# OpenCode update evidence\n'
for pkg in "${packages[@]}"; do
  show_package "$pkg" || status=1
done
exit "$status"

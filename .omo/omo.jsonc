// Canonical OMO configuration for OpenCode.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "[opencode]": {
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 3,
      "max_members": 6,
      "tmux_visualization": false
    },
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-terra-fast",
        "reasoning": "high"
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-terra-fast",
        "reasoning": "high"
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "medium"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "medium"
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol-fast",
        "reasoning": "high"
      },
      "prometheus": {
        "model": "openai/gpt-5.6-sol-fast",
        "reasoning": "high"
      },
      "metis": {
        "model": "openai/gpt-5.6-sol-fast",
        "reasoning": "high"
      },
      "momus": {
        "model": "openai/gpt-5.6-sol-fast",
        "reasoning": "xhigh"
      },
      "atlas": {
        "model": "openai/gpt-5.6-terra-fast",
        "reasoning": "high"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "medium"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      },
      "deep": {
        "model": "openai/gpt-5.6-terra-fast",
        "reasoning": "high"
      },
      "artistry": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "quick": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "medium",
        "models": [
          {
            "model": "openai/gpt-5.6-luna",
            "reasoning": "medium"
          }
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-terra-fast",
        "reasoning": "medium"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-terra-fast",
        "reasoning": "high",
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "high"
          }
        ]
      },
      "writing": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "medium"
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
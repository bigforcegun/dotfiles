// Canonical OMO configuration for OpenCode.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "[opencode]": {
    "team_mode": {
      "enabled": false,
      "max_parallel_members": 3,
      "max_members": 6,
      "tmux_visualization": false
    },
    "agents": {
      "sisyphus": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "medium"
          }
        ]
      },
      "hephaestus": {
        "models": [
          {
            "model": "openai/gpt-6-sol",
            "reasoning": "medium"
          }
        ]
      },
      "oracle": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "xhigh"
          }
        ]
      },
      "librarian": {
        "models": [
          {
            "model": "openai/gpt-6-luna-fast",
            "reasoning": "low"
          }
        ]
      },
      "explore": {
        "models": [
          {
            "model": "openai/gpt-6-luna-fast",
            "reasoning": "low"
          }
        ]
      },
      "multimodal-looker": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "low"
          }
        ]
      },
      "prometheus": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "high"
          }
        ]
      },
      "metis": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "high"
          }
        ]
      },
      "momus": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "xhigh"
          }
        ]
      },
      "atlas": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "medium"
          }
        ]
      },
      "sisyphus-junior": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "medium"
          }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "high"
          }
        ]
      },
      "ultrabrain": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "max"
          }
        ]
      },
      "deep-low": {
        "models": [
          {
            "model": "openai/gpt-6.1-sol",
            "reasoning": "medium"
          }
        ]
      },
      "deep-high": {
        "models": [
          {
            "model": "openai/gpt-6-astra",
            "reasoning": "high"
          }
        ]
      },
      "artistry": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "xhigh"
          }
        ]
      },
      "quick": {
        "models": [
          {
            "model": "openai/gpt-6-luna-fast",
            "reasoning": "low"
          }
        ]
      },
      "unspecified-low": {
        "models": [
          {
            "model": "openai/gpt-5.6-terra",
            "reasoning": "high"
          }
        ]
      },
      "unspecified-high": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "high"
          }
        ]
      },
      "writing": {
        "models": [
          {
            "model": "openai/gpt-5.6-sol",
            "reasoning": "medium"
          }
        ]
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
